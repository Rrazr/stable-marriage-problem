# Prerequisites
# Ignore build directory
build/

# Ignore compiled executables and libraries
*.exe
*.out
*.app
*.obj
*.o
*.pdb
*.ilk

# Ignore Visual Studio and VS Code local settings
.vs/
.vscode/
bin/
obj/

# Ignore contents of inputs and outputs but keep the folders
inputs/*
!inputs/.gitkeep
outputs/*
!outputs/.gitkeep
